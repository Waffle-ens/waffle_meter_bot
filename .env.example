DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/replace/me

# 10 minutes
CHECK_INTERVAL_SECONDS=600

# Only this version string is cached in the state file.
STATE_FILE=/data/state.json

# First run stores the current version silently by default.
SEND_INITIAL_NOTIFICATION=false

# Optional. Not needed for 10-minute polling, but useful if the server shares a GitHub API rate limit.
GITHUB_TOKEN=

# Optional.
GITHUB_REPOSITORY=Waffle-ens/waffle_meter
INCLUDE_PRERELEASES=false
DRY_RUN=false
