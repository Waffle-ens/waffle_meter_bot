DISCORD_BOT_TOKEN=replace-me

# 10 minutes
CHECK_INTERVAL_SECONDS=600

# Cached global latest version and per-server notification channels.
STATE_FILE=/data/state.json
DB_FILE=/data/bot.db

# First run stores the current version silently by default.
SEND_INITIAL_NOTIFICATION=false

# Optional. Useful if the server shares a GitHub API rate limit.
GITHUB_TOKEN=

# Optional.
GITHUB_REPOSITORY=Waffle-ens/waffle_meter
INCLUDE_PRERELEASES=false

# Slash command sync. Global sync can take up to about 1 hour to appear in Discord.
SYNC_COMMANDS=true
DISCORD_TEST_GUILD_ID=
